# PERENNIA WEB — Environment Configuration

# ─── SECURITY (Required) ─────────────────────────────────────
# Generate with: python scripts/gen_secrets.py
SECRET_KEY=your-secret-key-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-here-base64
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# ─── SERVER ──────────────────────────────────────────────────
PORT=443
HOST=0.0.0.0
ALLOWED_ORIGINS=https://example.com

# ─── SSL/TLS HTTPS (Production) ──────────────────────────
SSL_CERT_FILE=./certs/server.crt
SSL_KEY_FILE=./certs/server.key

# ─── DIRECTORIES ─────────────────────────────────────────────
DATA_DIR=./data
PUBLIC_DIR=./public

# ─── ADMIN ───────────────────────────────────────────────────
ADMIN_USERNAME=admin

# ─── SESSIONS & COOKIES ──────────────────────────────────────
SESSION_TTL_SECONDS=3600
COOKIE_SECURE=true

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_APPOINTMENT=6/hour

# ─── CHAT ────────────────────────────────────────────────────
MAX_CHAT_EXCHANGES=15

# ─── APPOINTMENTS ────────────────────────────────────────────
APPT_TIMEZONE=Asia/Kuwait
APPT_SLOT_MINUTES=30
APPT_DAY_START_HOUR=9
APPT_DAY_END_HOUR=17
APPT_WORKDAYS=0,1,2,3,4
APPT_MAX_DAYS_AHEAD=30

# ─── GOOGLE CALENDAR (Optional) ──────────────────────────────
# Path to Google service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=
# Google Calendar ID to sync appointments
GOOGLE_CALENDAR_ID=
